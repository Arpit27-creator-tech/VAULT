# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vault_db

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Server
PORT=5000
NODE_ENV=development

# CORS — set to your frontend URL
CORS_ORIGIN=http://localhost:3000

# Email Option 1: Resend HTTP REST API (Recommended for Render Free / Vercel — never blocked)
# Get a free key at https://resend.com (3,000 emails/month free)
RESEND_API_KEY=re_123456789
RESEND_FROM="V.A.U.L.T HQ <onboarding@resend.dev>"

# Email Option 2: Brevo HTTP REST API (300 emails/day free)
# Get a free key at https://brevo.com
BREVO_API_KEY=xkeysib-...

# Email Option 3: SMTP (Gmail App Password) — Note: Blocked on Render Free tier
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="VAULT Protocol <your-email@gmail.com>"

